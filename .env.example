# Get these from poynt.godaddy.com > Business Settings > Poynt Collect API Settings
# The dashboard shows: BUSINESS_ID=APPLICATION_ID
# Split on "=" to get both values

BUSINESS_ID=your-business-uuid-here
APPLICATION_ID=urn:aid:your-application-id-here
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
Your private key here (entire PEM block)
-----END RSA PRIVATE KEY-----"

PORT=3000
